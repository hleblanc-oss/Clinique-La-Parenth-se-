# Écosystème Square — clés UNIQUEMENT côté serveur (jamais exposées au client).
# À créer dans le Square Developer Dashboard de la cliente :
# https://developer.squareup.com/apps → créer une application → onglet Credentials.
#
# Développer et tester en mode Sandbox AVANT tout passage en production.

# "sandbox" ou "production"
SQUARE_ENVIRONMENT=sandbox

# Jeton d'accès (Sandbox Access Token pour commencer)
SQUARE_ACCESS_TOKEN=

# ID de l'application Square
SQUARE_APPLICATION_ID=

# ID de l'emplacement. Sandbox : voir « Locations » du Developer Dashboard.
# Production (compte de la cliente) : LN4WVN4CZP6QN
SQUARE_LOCATION_ID=

# Clé de signature des webhooks (Phases 2-3 : inventaire, commandes)
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Fournisseur de données du site :
#   mock   → données locales réalistes (développement/démo sans compte Square)
#   square → écosystème Square réel (défaut)
DATA_PROVIDER=square
